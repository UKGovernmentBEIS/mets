        <flowable:task-candidates-type>all</flowable:task-candidates-type>
        <design:stencilid>FormTask</design:stencilid>
        <design:stencilsuperid>Task</design:stencilsuperid>
      </extensionElements>
    </userTask>
    <callActivity id="PERMIT_ISSUANCE_REVIEW" name="Review Permit Issuance Application" calledElement="APPL_REVIEW" flowable:inheritBusinessKey="true" flowable:sameDeployment="true" flowable:fallbackToDefaultTenant="true">
