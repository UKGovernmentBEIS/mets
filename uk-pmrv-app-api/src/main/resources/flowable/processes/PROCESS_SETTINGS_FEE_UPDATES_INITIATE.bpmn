  <process id="PROCESS_SETTINGS_FEE_UPDATES_INITIATE" name="Settings scheduled fee updates" isExecutable="true">
    <extensionElements>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
    </extensionElements>
    <startEvent id="SETTINGS_FEE_UPDATES_TIMER" name="Settings fee updates timer">
      <timerEventDefinition>
        <timeCycle>R/2026-08-07T00:01:00/P1D</timeCycle>
      </timerEventDefinition>
    </startEvent>
    <serviceTask id="APPLY_SCHEDULED_FEE_UPDATES" name="Apply scheduled fee updates" flowable:exclusive="true" flowable:async="true" flowable:delegateExpression="#{applyScheduledFeeUpdatesHandlerFlowable}">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <endEvent id="Event_SettingsFeeUpdates_End">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
      </extensionElements>
    </endEvent>
    <sequenceFlow id="Flow_TimerToTask" sourceRef="SETTINGS_FEE_UPDATES_TIMER" targetRef="APPLY_SCHEDULED_FEE_UPDATES">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="Flow_TaskToEnd" sourceRef="APPLY_SCHEDULED_FEE_UPDATES" targetRef="Event_SettingsFeeUpdates_End">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PROCESS_SETTINGS_FEE_UPDATES_INITIATE">
    <bpmndi:BPMNPlane bpmnElement="PROCESS_SETTINGS_FEE_UPDATES_INITIATE" id="BPMNPlane_PROCESS_SETTINGS_FEE_UPDATES_INITIATE">
      <bpmndi:BPMNShape bpmnElement="SETTINGS_FEE_UPDATES_TIMER" id="BPMNShape_SETTINGS_FEE_UPDATES_TIMER">
        <omgdc:Bounds height="30.0" width="30.0" x="175.0" y="102.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="APPLY_SCHEDULED_FEE_UPDATES" id="BPMNShape_APPLY_SCHEDULED_FEE_UPDATES">
        <omgdc:Bounds height="80.0" width="100.0" x="327.0" y="77.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Event_SettingsFeeUpdates_End" id="BPMNShape_Event_SettingsFeeUpdates_End">
        <omgdc:Bounds height="28.0" width="28.0" x="547.0" y="103.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="Flow_TimerToTask" id="BPMNEdge_Flow_TimerToTask" flowable:sourceDockerX="15.0" flowable:sourceDockerY="15.0" flowable:targetDockerX="50.0" flowable:targetDockerY="40.0">
        <omgdi:waypoint x="205.0" y="117.0"></omgdi:waypoint>
        <omgdi:waypoint x="327.0" y="117.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_TaskToEnd" id="BPMNEdge_Flow_TaskToEnd" flowable:sourceDockerX="50.0" flowable:sourceDockerY="40.0" flowable:targetDockerX="14.0" flowable:targetDockerY="14.0">
        <omgdi:waypoint x="427.0" y="117.0"></omgdi:waypoint>
        <omgdi:waypoint x="547.0" y="117.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
