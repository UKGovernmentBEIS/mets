                <bpmndi:BPMNLabel>
                    <dc:Bounds x="152" y="145" width="81" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Activity_152jtlu_di" bpmnElement="Activity_152jtlu">
                <dc:Bounds x="460" y="80" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Event_1hrom29_di" bpmnElement="Event_1hrom29">
