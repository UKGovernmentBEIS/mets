                  xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_11ggzbr"
                  targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.39.0"
                  modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
    <bpmn:process id="PROCESS_BDRS2_INITIATE" name="" isExecutable="true" camunda:historyTimeToLive="180">
        <bpmn:serviceTask id="Activity_1ttk3r7" name="Collect accounts for BDRS2"
                          camunda:delegateExpression="#{collectInstallationAccountsForBDRS2Handler}">
            <bpmn:extensionElements>
                <camunda:inputOutput>
                    <camunda:outputParameter name="accountIds">
                        <camunda:list/>
                    </camunda:outputParameter>
                </camunda:inputOutput>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_0uvz7fx</bpmn:incoming>
            <bpmn:outgoing>Flow_1sffi33</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:startEvent id="Event_070qnvy" name="BDRS2 initiation">
            <bpmn:outgoing>Flow_0uvz7fx</bpmn:outgoing>
            <bpmn:timerEventDefinition id="TimerEventDefinition_0il6gt8">
                <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2026-04-01T00:00Z</bpmn:timeDate>
            </bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_0uvz7fx" sourceRef="Event_070qnvy" targetRef="Activity_1ttk3r7"/>
        <bpmn:serviceTask id="Activity_152jtlu" name="Create BDRS2 task"
                          camunda:delegateExpression="#{initiateBDRS2Handler}">
            <bpmn:extensionElements>
                <camunda:inputOutput>
                    <camunda:inputParameter name="accountIds">
                        <camunda:list/>
                    </camunda:inputParameter>
                </camunda:inputOutput>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_1sffi33</bpmn:incoming>
            <bpmn:outgoing>Flow_1elh5mj</bpmn:outgoing>
            <bpmn:multiInstanceLoopCharacteristics camunda:asyncBefore="true" camunda:collection="accounts"
                                                   camunda:elementVariable="accountId"/>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_1sffi33" sourceRef="Activity_1ttk3r7" targetRef="Activity_152jtlu"/>
        <bpmn:endEvent id="Event_1hrom29">
            <bpmn:incoming>Flow_1elh5mj</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_1elh5mj" sourceRef="Activity_152jtlu" targetRef="Event_1hrom29"/>
    </bpmn:process>
    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="PROCESS_BDRS2_INITIATE">
            <bpmndi:BPMNShape id="Activity_1ttk3r7_di" bpmnElement="Activity_1ttk3r7">
                <dc:Bounds x="290" y="80" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Event_070qnvy_di" bpmnElement="Event_070qnvy">
