<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_0s0wwit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:process id="PROCESS_NER" name="New entrant Reserve" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0kzrsre</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="NER_APPLICATION_SUBMIT" name="Operator:Submit NER Application">
      <bpmn:incoming>Flow_06yib7k</bpmn:incoming>
      <bpmn:incoming>Flow_1vdhcf5</bpmn:incoming>
      <bpmn:outgoing>Flow_1x5pmv2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="NER_REVIEW" name="Review NER Application" calledElement="PROCESS_APPLICATION_REVIEW">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{businessKey}" />
        <camunda:in source="businessKey" target="businessKey" />
        <camunda:in source="requestId" target="requestId" />
        <camunda:in source="requestType" target="requestType" />
        <camunda:out source="reviewOutcome" target="reviewOutcome" />
        <camunda:out source="sendNotice" target="sendNotice" />
        <camunda:out source="applicationReviewExpirationDate" target="applicationReviewExpirationDate" />
        <camunda:out source="applicationReviewFirstReminderDate" target="applicationReviewFirstReminderDate" />
        <camunda:out source="applicationReviewSecondReminderDate" target="applicationReviewSecondReminderDate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ha07o4</bpmn:incoming>
      <bpmn:incoming>Flow_1nns4cj</bpmn:incoming>
      <bpmn:outgoing>Flow_0ojr7ap</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_1x5pmv2" sourceRef="NER_APPLICATION_SUBMIT" targetRef="Gateway_0oi6g1z" />
    <bpmn:sequenceFlow id="Flow_0ojr7ap" sourceRef="NER_REVIEW" targetRef="Gateway_1vt063r" />
    <bpmn:endEvent id="Event_1e3vtqj">
      <bpmn:incoming>Flow_13fz0yf</bpmn:incoming>
      <bpmn:incoming>Flow_0p9lryf</bpmn:incoming>
      <bpmn:incoming>Flow_01n08xo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_0oi6g1z" name="what is the submit outcome?">
      <bpmn:incoming>Flow_1x5pmv2</bpmn:incoming>
      <bpmn:outgoing>Flow_1ha07o4</bpmn:outgoing>
      <bpmn:outgoing>Flow_0czve4x</bpmn:outgoing>
      <bpmn:outgoing>Flow_0qen77p</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1ha07o4" name="submitted" sourceRef="Gateway_0oi6g1z" targetRef="NER_REVIEW">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nerSubmitOutcome=='SUBMITTED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0czve4x" name="cancelled" sourceRef="Gateway_0oi6g1z" targetRef="Activity_0tx49mt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nerSubmitOutcome=='CANCELLED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_1vt063r" name="what is the review determination?">
      <bpmn:incoming>Flow_0ojr7ap</bpmn:incoming>
      <bpmn:outgoing>Flow_05ikahu</bpmn:outgoing>
      <bpmn:outgoing>Flow_11oqj0w</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0b7u0q9" sourceRef="Activity_0tx49mt" targetRef="Activity_0f8pqc4" />
    <bpmn:serviceTask id="Activity_0tx49mt" name="Handle NER Cancelled" camunda:delegateExpression="#{nerApplicationCancelledHandler}">
      <bpmn:incoming>Flow_0czve4x</bpmn:incoming>
      <bpmn:outgoing>Flow_0b7u0q9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0f8pqc4" name="Update Workflow status to CANCELLED" camunda:delegateExpression="#{requestUpdateStatusHandler}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="requestStatus">CANCELLED</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0b7u0q9</bpmn:incoming>
      <bpmn:outgoing>Flow_13fz0yf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_13fz0yf" sourceRef="Activity_0f8pqc4" targetRef="Event_1e3vtqj" />
    <bpmn:serviceTask id="Activity_1gtjb5i" name="Update Workflow status to COMPLETED" camunda:delegateExpression="#{requestUpdateStatusHandler}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="requestStatus">COMPLETED</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0m34oy2</bpmn:incoming>
      <bpmn:outgoing>Flow_0p9lryf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0p9lryf" sourceRef="Activity_1gtjb5i" targetRef="Event_1e3vtqj" />
    <bpmn:serviceTask id="Activity_0wnh0ea" name="Update Workflow status to WITHDRAWN" camunda:delegateExpression="#{requestUpdateStatusHandler}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="requestStatus">WITHDRAWN</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0g7z5q2</bpmn:incoming>
      <bpmn:outgoing>Flow_01n08xo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_01n08xo" sourceRef="Activity_0wnh0ea" targetRef="Event_1e3vtqj" />
    <bpmn:callActivity id="Activity_0nqsgst" name="Verification" calledElement="PROCESS_VERIFICATION">
      <bpmn:extensionElements>
        <camunda:in source="requestId" target="requestId" />
        <camunda:in source="requestType" target="requestType" />
        <camunda:in businessKey="#{businessKey}" />
        <camunda:in source="businessKey" target="businessKey" />
        <camunda:out source="nerSubmitOutcome" target="nerSubmitOutcome" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0qen77p</bpmn:incoming>
      <bpmn:outgoing>Flow_06yib7k</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_0qen77p" sourceRef="Gateway_0oi6g1z" targetRef="Activity_0nqsgst">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nerSubmitOutcome=='SUBMITTED_TO_VERIFIER'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06yib7k" sourceRef="Activity_0nqsgst" targetRef="NER_APPLICATION_SUBMIT" />
    <bpmn:serviceTask id="Activity_0xpnecr" name="Send official notice" camunda:delegateExpression="#{nerSendOfficialNoticeHandler}">
      <bpmn:incoming>Flow_05ikahu</bpmn:incoming>
      <bpmn:outgoing>Flow_0g7z5q2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_05ikahu" sourceRef="Gateway_1vt063r" targetRef="Activity_0xpnecr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reviewOutcome=='DEEMED_WITHDRAWN'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0g7z5q2" sourceRef="Activity_0xpnecr" targetRef="Activity_0wnh0ea" />
