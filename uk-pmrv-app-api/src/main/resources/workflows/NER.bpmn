    <bpmn:sequenceFlow id="Flow_0kzrsre" sourceRef="StartEvent_1" targetRef="Gateway_0u4eg65" />
    <bpmn:sequenceFlow id="Flow_1vdhcf5" sourceRef="Gateway_0u4eg65" targetRef="NER_APPLICATION_SUBMIT" />
    <bpmn:sequenceFlow id="Flow_1nns4cj" sourceRef="Gateway_0u4eg65" targetRef="NER_REVIEW">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nerInitiationType=='RE_INITIATED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
