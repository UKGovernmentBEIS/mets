    <bpmn:sequenceFlow id="Flow_11oqj0w" sourceRef="Gateway_1vt063r" targetRef="Activity_17qtek7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reviewOutcome=='COMPLETED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0m34oy2" sourceRef="Activity_17qtek7" targetRef="Activity_1gtjb5i" />
    <bpmn:exclusiveGateway id="Gateway_0u4eg65" name="is NER re initiated?" default="Flow_1vdhcf5">
      <bpmn:incoming>Flow_0kzrsre</bpmn:incoming>
      <bpmn:outgoing>Flow_1vdhcf5</bpmn:outgoing>
      <bpmn:outgoing>Flow_1nns4cj</bpmn:outgoing>
