<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="0_2_0_account_file_attachment_seq" author="alekopoulosd@unisystems.gr">
        <createSequence
                sequenceName="account_file_attachment_seq"
                startValue="1"
                incrementBy="1"
                minValue="1"
                cycle="false"/>

        <rollback>
            <sql>DROP SEQUENCE IF EXISTS account_file_attachment;</sql>
        </rollback>
    </changeSet>
    <changeSet id="0_2_0_account_file_attachment_table" author="alekopoulosd@unisystems.gr">

        <createTable tableName="account_file_attachment">

            <column name="id" type="bigint">
                <constraints primaryKey="true"
                             primaryKeyName="account_file_attachment_pk"
                             nullable="false"/>
            </column>

            <column name="workflow" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="workflow_subtype" type="varchar(255)">
                <constraints nullable="true"/>
            </column>

            <column name="originated_request_id" type="varchar(20)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="account_id" type="bigint">
                <constraints nullable="false"/>
            </column>

            <column name="period" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="file_uuid" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="competent_authority" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="creation_date" type="timestamp">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <rollback>
            <sql>DROP TABLE IF EXISTS account_file_attachment CASCADE;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>