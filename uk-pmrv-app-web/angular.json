{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "uk-pmrv-main-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        },
        "@schematics/angular:component": {
          "type": "component",
          "style": "scss",
          "changeDetection": "OnPush",
          "inlineStyle": true
        },
        "@schematics/angular:directive": { "type": "directive" },
        "@schematics/angular:service": { "type": "service" },
        "@schematics/angular:guard": { "typeSeparator": "." },
        "@schematics/angular:interceptor": { "typeSeparator": "." },
        "@schematics/angular:module": { "typeSeparator": "." },
        "@schematics/angular:pipe": { "typeSeparator": "." },
        "@schematics/angular:resolver": { "typeSeparator": "." }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/uk-pmrv-main-web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["src/polyfills.ts"],
            "tsConfig": "tsconfig.app.json",
            "sourceMap": {
              "styles": true,
              "scripts": true,
              "vendor": true
            },
            "assets": [
              "src/assets",
              {
                "glob": "**/*",
                "input": "./node_modules/govuk-frontend/dist/govuk/assets",
                "output": "/assets/"
              }
            ],
            "styles": ["src/styles.scss", "node_modules/dialog-polyfill/dialog-polyfill.css"],
            "stylePreprocessorOptions": {
              "includePaths": ["node_modules/govuk-frontend/dist/govuk/"]
            },
            "scripts": [],
            "allowedCommonJsDependencies": [
              "keycloak-js",
              "clean-deep",
              "crypto-js",
              "zxcvbn",
              "base64-js",
              "js-sha256",
              "moment",
              "lodash",
              "google-libphonenumber",
              "encoding-japanese",
              "papaparse"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "4mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "uk-pmrv-main-web:build:production"
            },
            "development": {
              "buildTarget": "uk-pmrv-main-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "uk-pmrv-main-web:build"
          }
        },
        "test": {
          "builder": "@angular-builders/jest:run",
          "options": {}
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    },
    "govuk-components": {
      "projectType": "library",
      "root": "projects/govuk-components",
      "sourceRoot": "projects/govuk-components/src",
      "prefix": "govuk",
      "schematics": {
        "@schematics/angular:component": {
          "inlineStyle": true,
          "inlineTemplate": true,
          "changeDetection": "OnPush"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/govuk-components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/govuk-components/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/govuk-components/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-builders/jest:run",
          "options": {
            "tsConfig": "projects/govuk-components/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/govuk-components/**/*.ts", "projects/govuk-components/**/*.html"]
          }
        }
      }
    },
    "pmrv-api": {
      "projectType": "library",
      "root": "projects/pmrv-api",
      "sourceRoot": "projects/pmrv-api/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/pmrv-api/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/pmrv-api/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/pmrv-api/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/pmrv-api/**/*.ts"]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": ["@angular-eslint/schematics"],
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
